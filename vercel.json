{
    "rewrites": [
        {
            "source": "/nhan-xet-tt27",
            "destination": "/nhan-xet-tt27/index.html"
        },
        {
            "source": "/lucky-wheel",
            "destination": "/lucky-wheel/index.html"
        },
        {
            "source": "/game-tùy-chỉnh",
            "destination": "/game-tùy-chỉnh/index.html"
        },
        {
            "source": "/chuctettudong",
            "destination": "/chuctettudong/index.html"
        },
        {
            "source": "/about",
            "destination": "/about/index.html"
        },
        {
            "source": "/privacy",
            "destination": "/privacy/index.html"
        },
        {
            "source": "/terms",
            "destination": "/terms/index.html"
        },
        {
            "source": "/contact",
            "destination": "/contact/index.html"
        },
        {
            "source": "/((?!giải-mã-bức-tranh|game-tùy-chỉnh|lucky-wheel|hinh-hoc-3d|chuctettudong|nhan-xet-tt27|about|privacy|terms|contact|assets|.*\\.[a-z]+$).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}