# Environment Variables cho Giáo viên yêu công nghệ

# Gemini API Keys (nhiều keys cách nhau bởi dấu phẩy)
# QUAN TRỌNG: Thêm biến này vào Vercel Dashboard, KHÔNG thêm vào file này!
GEMINI_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3

# App soạn giáo án năng lực số / AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
